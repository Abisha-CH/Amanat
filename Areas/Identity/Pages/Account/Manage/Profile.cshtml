@page
@model ProfileModel

  <main class="auth-shell auth-shell-wide" aria-label="Profile split wrapper">

    <section class="auth-brand col-lg-5">
      <div class="position-relative" style="z-index: 1;">
        <div class="d-flex align-items-center mb-4">
          <span class="logo-urdu" style="font-size: 2.6rem;">امانت</span>
        </div>
        <h1 class="font-display fw-bold mb-2" style="font-size: clamp(1.9rem, 3vw, 2.3rem);">Your Amanat Profile</h1>
        <p class="mb-0" style="color: rgba(209,250,229,0.9); max-width: 20rem;">
          Keep your contact details current while your access level stays administrator-managed.
        </p>
      </div>

      <div class="position-relative mt-4" style="z-index: 1;">
        <div class="auth-photo auth-photo-square">
          <img src="~/assets/images/auth-civic-building.jpg" alt="Civic and institutional building representing community integrity">
        </div>
        <div class="mt-3 d-flex align-items-center justify-content-center gap-2 text-uppercase letter-wide" style="font-size: 0.66rem; color: rgba(209,250,229,0.75);">
          <span class="rounded-circle bg-light-green" style="width: 0.4rem; height: 0.4rem;"></span>
          <span>Verified Public Ledger</span>
        </div>
      </div>
    </section>

    <section class="auth-form-panel col-lg-7">
      <div class="mx-auto w-100" style="max-width: 28rem;">
        <header class="mb-4">
          <h2 class="h3 fw-bold text-ink mb-1">Profile Details</h2>
          <p class="text-muted-amanat small mb-0">Update how your name and phone number appear on Amanat records.</p>
        </header>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
          <div class="alert alert-success py-2 small" role="status" data-profile-status>@Model.StatusMessage</div>
        }

        <form method="post" class="vstack gap-3">
          <div asp-validation-summary="All" class="text-danger small"></div>

          <div class="input-icon-shell">
            <i class="bi bi-person"></i>
            <label class="visually-hidden" for="fullName">Full Name</label>
            <input class="form-control" asp-for="Input.FullName" id="fullName" type="text" placeholder="Full Name"
              autocomplete="name">
            <div class="invalid-feedback">Please enter your full name.</div>
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
          </div>

          <div class="input-icon-shell">
            <i class="bi bi-telephone"></i>
            <label class="visually-hidden" for="phone">Phone Number</label>
            <input class="form-control" asp-for="Input.PhoneNumber" id="phone" type="tel" placeholder="Phone Number"
              autocomplete="tel">
            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
          </div>

          <div class="border rounded-3 p-3 small">
            <div>
              <span class="text-muted-amanat">Email</span>
              <span id="profile-email" class="d-block text-break fw-medium text-ink">@Model.Email</span>
            </div>
            <div class="mt-2">
              <span class="text-muted-amanat">Access role</span>
              <span id="profile-role" class="d-block fw-medium text-forest">@Model.RoleText</span>
            </div>
            <div class="mt-2">
              <span class="text-muted-amanat">Member since</span>
              <span id="profile-member-since" class="d-block fw-medium text-ink">@Model.MemberSince</span>
            </div>
          </div>

          <p class="small text-muted-amanat mb-0">Organizer and Treasurer access is assigned by an administrator.</p>

          <button class="btn btn-forest w-100" type="submit">Save Profile</button>
        </form>

        <p class="text-center small text-muted-amanat mt-4 mb-0">
          <a class="fw-semibold text-forest text-decoration-none" asp-controller="Home" asp-action="Index">Return to Amanat</a>
        </p>
      </div>
    </section>

  </main>
