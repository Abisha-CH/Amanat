@{
    ViewData["Title"] = "Access Denied | AMANAT";
}
<section class="container py-5 text-center">
  <span class="icon-square bg-forest-soft mb-3"><i class="bi bi-shield-lock fs-4"></i></span>
  <h1 class="h3 fw-bold text-forest mb-2">This area requires a different Amanat role.</h1>
  <p class="text-muted-amanat mb-4">Sign in with the Organizer, Treasurer or Contributor account assigned to your workspace.</p>
  <div class="d-flex flex-wrap justify-content-center gap-3">
    <a class="btn btn-forest" asp-controller="Home" asp-action="Index">Return Home</a>
    <a class="btn btn-outline-forest" asp-area="Identity" asp-page="/Account/Login">Go to Login</a>
  </div>
</section>
