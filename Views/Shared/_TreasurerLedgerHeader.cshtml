<header class="bg-white border-bottom border-amanat sticky-top">
  <div class="container-xxl d-flex align-items-center justify-content-between gap-3 py-3 px-3 px-lg-4">
    <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
      <span class="logo-urdu">امانت</span>
      <span class="vr d-none d-sm-block opacity-25"></span>
      <span class="small fw-semibold text-muted-amanat d-none d-sm-block">Treasurer Workspace</span>
    </a>
    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-outline-forest btn-sm d-none d-sm-inline-flex" asp-controller="Treasurer" asp-action="Dashboard">
        <i class="bi bi-speedometer2 me-1"></i> Dashboard
      </a>
      <a class="btn btn-outline-forest btn-sm d-none d-md-inline-flex" asp-controller="Public" asp-action="Ledger">
        <i class="bi bi-bank me-1"></i> Public Ledger
      </a>
      <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
        <button class="btn btn-forest btn-sm" type="submit"><i class="bi bi-box-arrow-left me-1"></i> Exit</button>
      </form>
    </div>
  </div>
</header>
