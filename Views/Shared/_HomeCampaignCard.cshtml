@model Campaign
<div class="col-sm-6 col-lg-3">
  <div class="card-amanat card-hover campaign-card">
    <div class="campaign-thumb">
      <img src="~/@Model.HomeThumbnail" alt="@Model.HomeThumbnailAlt">
      <span class="thumb-badge">Active</span>
    </div>
    <div class="card-body">
      <div>
        <h3 class="h6 fw-bold text-forest mb-1 clamp-1">@Model.Title</h3>
        <p class="text-muted-amanat small mb-0 clamp-2">
          @Model.HomeSummary
        </p>
      </div>
      <div class="campaign-footer pt-3 mt-3 border-top border-amanat">
        <div class="d-flex justify-content-between align-items-center small mb-1">
          <span class="text-muted-amanat fw-medium">Funded</span>
          <span class="fw-bold text-forest">@Model.ProgressPercent%</span>
        </div>
        <div class="progress mb-3">
          <div class="progress-bar" style="width: @Model.ProgressPercent%"></div>
        </div>
        <div class="d-flex justify-content-between align-items-baseline mb-3">
          <span class="text-muted-amanat small">Raised</span>
          <div class="text-end">
            <span class="fw-bold text-forest small">@Model.RaisedText</span>
            <span class="text-muted-amanat d-block" style="font-size: 0.62rem;">of @Model.GoalText</span>
          </div>
        </div>
        <a class="btn btn-forest w-100 btn-sm" asp-controller="Campaigns" asp-action="Details" asp-route-id="@Model.Slug">Contribute / Audit</a>
      </div>
    </div>
  </div>
</div>
