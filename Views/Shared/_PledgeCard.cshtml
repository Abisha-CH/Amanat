@model PledgeCard
<div class="col-lg-6">
  <article class="card-amanat h-100 p-4 d-flex flex-column justify-content-between">
    <div class="d-flex flex-column flex-sm-row gap-3">
      <img class="rounded-3 border border-amanat flex-shrink-0" style="width: 100%; height: 7rem; object-fit: cover; max-width: 9rem;"
        src="~/@Model.ImagePath" alt="@Model.ImageAlt">
      <div class="flex-grow-1">
        <div class="d-flex align-items-start justify-content-between gap-2">
          <h3 class="h6 fw-bold text-ink mb-0">@Model.CampaignTitle</h3>
          <span class="badge-amanat @(Model.IsVerified ? "badge-verified" : "badge-pending")">@Model.Status</span>
        </div>
        <p class="text-muted-amanat mt-1 mb-2 clamp-2" style="font-size: 0.72rem;">
          @Model.Description
        </p>
        <div class="d-flex align-items-baseline justify-content-between" style="font-size: 0.72rem;">
          <span class="text-muted-amanat fw-medium">@Model.RaisedText</span>
          <span class="text-muted-amanat">@Model.TargetText</span>
        </div>
        <div class="progress progress-thin mt-2"><div class="progress-bar bg-forest" style="width: @Model.Percent%"></div></div>
        <span class="d-inline-block text-forest fw-semibold mt-1" style="font-size: 0.68rem;">@Model.Percent% Funded</span>
      </div>
    </div>
    <div class="mt-3 pt-3 border-top border-amanat d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 bg-surface p-3 rounded-3">
      <div>
        <p class="mb-0 fw-semibold text-ink" style="font-size: 0.72rem;">@Model.YourPledgeText</p>
        <p class="mb-0 fw-medium d-flex align-items-center gap-1" style="font-size: 0.68rem; @Model.PaymentStyle">
          @if (Model.IsVerified)
          {
            <i class="bi bi-check2"></i>
          }
          @Model.PaymentText
        </p>
      </div>
      <a class="btn @(Model.ButtonOutline ? "btn-outline-forest" : "btn-forest") btn-sm" href="@Model.ButtonTarget">@Model.ButtonText</a>
    </div>
  </article>
</div>
