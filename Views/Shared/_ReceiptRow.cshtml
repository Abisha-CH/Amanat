@model Receipt
<div class="receipt-row d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3" style="opacity: @(Model.IsVerified ? "1" : "0.85");">
  <div class="d-flex align-items-center gap-3">
    <img class="receipt-thumb" src="~/@Model.ImagePath" alt="@Model.ImageAlt">
    <div>
      <h4 class="h6 fw-semibold text-ink mb-1">@Model.Title</h4>
      <div class="d-flex flex-wrap align-items-center gap-2 text-muted-amanat" style="font-size: 0.72rem;">
        <span class="cell-mono bg-surface px-1 rounded">@Model.Reference</span>
        <span>&bull;</span>
        <span>@Model.Vendor</span>
      </div>
    </div>
  </div>
  <div class="d-flex align-items-center justify-content-between justify-content-sm-end gap-3 w-100 w-sm-auto">
    <div class="text-end">
      <span class="small fw-bold text-ink d-block">@Model.AmountText</span>
      @if (Model.IsVerified)
      {
        <span class="badge-amanat badge-verified mt-1"><i class="bi bi-check2"></i> Approved &amp; Verified</span>
      }
      else
      {
        <span class="badge-amanat badge-pending mt-1"><i class="bi bi-clock"></i> Under Review</span>
      }
    </div>
    @if (Model.IsVerified)
    {
      <button class="btn btn-outline-forest btn-sm js-demo-link" data-demo-message="Receipt slip preview is part of the interactive demo." type="button">View Slip</button>
    }
    else
    {
      <button class="btn btn-outline-secondary btn-sm js-demo-link" data-demo-message="Pending receipts are reviewed by the treasurer." type="button">Pending Audit</button>
    }
  </div>
</div>
