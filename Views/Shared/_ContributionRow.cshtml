@model ContributionRow
<tr style="@Model.RowStyle">
  <td class="text-muted-amanat text-nowrap">@Model.DateText</td>
  <td class="cell-title text-nowrap">@Model.Campaign</td>
  <td class="fw-bold text-nowrap">@Model.AmountText</td>
  <td class="cell-mono text-nowrap">@Model.Reference</td>
  <td class="text-nowrap"><span class="badge-amanat @(Model.IsPending ? "badge-pending" : "badge-verified")"><span class="badge-dot"></span> @Model.Status</span></td>
  <td class="text-end text-nowrap">
    @if (Model.IsPending)
    {
      <span class="text-muted-amanat fst-italic" style="font-size: 0.72rem;">Pending</span>
    }
    else
    {
      <a class="small fw-medium text-forest text-decoration-none js-demo-link" data-demo-message="Receipt preview is part of the interactive demo." href="#">
        <i class="bi bi-eye"></i> View
      </a>
    }
  </td>
</tr>
